<Project>
  <Target Name="GenerateExpoModulesProvider" BeforeTargets="CoreCompile"
          Inputs="$(ProjectDir)..\..\package.json"
          Outputs="$(ProjectDir)ExpoModulesProvider.g.cs">
    <Exec Command="bunx expo-modules-windows-core generate-modules-provider --platform windows --target &quot;$(ProjectDir)ExpoModulesProvider.g.cs&quot;" />
  </Target>
</Project>
