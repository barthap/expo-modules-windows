{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "expo-modules-windows-core": [
        "./packages/expo-modules-windows-core/src/index"
      ]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "resolvePackageJsonImports": false,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  },
  "include": [
    "apps/expo-desktop-windows-example/src/**/*",
    "packages/expo-modules-windows-core/src/**/*"
  ],
  "exclude": [
    "packages/expo-modules-windows-core/vendor/expo-modules-autolinking"
  ]
}
